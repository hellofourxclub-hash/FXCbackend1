# Backend Environment Variables

NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection String (get from MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/fxcbackend?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=your-secret-key-here

# Frontend URL
FRONTEND_URL=http://localhost:5173
